[{"id":"NEW-001","title":"Transfert sortant","values":{"ID":"NEW-001","Type":"Transfert sortant","Date / période":"1944-08-25","Origine":"Auschwitz","Destination / ensemble":"Neuengamme","Effectif":750,"Identités documentées":"550 identifiées ; 3 profils vérifiés individuellement dans notre base","État dans notre base":"Ajouté au calendrier et à la base SQL","Priorité":1,"Source":"https://auschwitz.org/en/museum/news/destroyed-identities-the-digital-reconstruction-of-auschwitz-birkenau-victims-data%2C1398.html","Remarque":"Profils déjà intégrés : Julian Dunikowski 34904, Stanisław Bujas 37254, Jan Reymann 37302. Le lien précis de Reymann avec le transfert du 25 août doit rester marqué à contrôler tant que la ligne nominative complète n’est pas publiquement visible."}},{"id":"NEW-002","title":"Transfert sortant","values":{"ID":"NEW-002","Type":"Transfert sortant","Date / période":"1944-10-27","Origine":"Auschwitz","Destination / ensemble":"Sachsenhausen","Effectif":2249,"Identités documentées":"349 noms conservés + 257 dossiers obtenus","État dans notre base":"Ajouté au calendrier et à la base SQL","Priorité":1,"Source":"https://www.auschwitz.org/en/museum/news/volunteer-academy-2025-612-september-call-for-participants%2C1764.html","Remarque":"Les 257 dossiers doivent être rapprochés des 349 noms avant de conclure à un nombre net de nouvelles personnes."}},{"id":"NEW-003","title":"Corpus de transports","values":{"ID":"NEW-003","Type":"Corpus de transports","Date / période":"1942–1944","Origine":"Lwów","Destination / ensemble":"Auschwitz","Effectif":"14 transports","Identités documentées":"À détailler","État dans notre base":"Backlog documenté","Priorité":2,"Source":"https://www.auschwitz.org/download/gfx/auschwitz/en/defaultstronaopisowa/358/21/1/report_2025.pdf","Remarque":"Créer une ligne par transport avec date, effectif, plages de matricules et source."}},{"id":"NEW-004","title":"Corpus de transports","values":{"ID":"NEW-004","Type":"Corpus de transports","Date / période":"1943–1944","Origine":"Divers","Destination / ensemble":"Roma et Sinti vers Auschwitz","Effectif":"176 transports","Identités documentées":"À détailler","État dans notre base":"Backlog documenté","Priorité":2,"Source":"https://www.auschwitz.org/download/gfx/auschwitz/en/defaultstronaopisowa/358/21/1/report_2025.pdf","Remarque":"Distinguer les transports des inscriptions dans la série Z et des naissances au camp."}},{"id":"NEW-005","title":"Corpus nominatif","values":{"ID":"NEW-005","Type":"Corpus nominatif","Date / période":"1943–1945","Origine":"Auschwitz","Destination / ensemble":"Enfants roms nés au camp","Effectif":350,"Identités documentées":"Dossiers/enregistrements ajoutés","État dans notre base":"Backlog documenté","Priorité":2,"Source":"https://www.auschwitz.org/download/gfx/auschwitz/en/defaultstronaopisowa/358/21/1/report_2025.pdf","Remarque":"Créer un identifiant anti-doublon par enfant avant toute fusion avec d'autres collections."}},{"id":"NEW-006","title":"Corpus nominatif","values":{"ID":"NEW-006","Type":"Corpus nominatif","Date / période":"1944","Origine":"Pruszków / Varsovie","Destination / ensemble":"Femmes déportées à Auschwitz","Effectif":5534,"Identités documentées":"À individualiser","État dans notre base":"Partiellement présent","Priorité":2,"Source":"https://www.auschwitz.org/download/gfx/auschwitz/en/defaultstronaopisowa/358/21/1/report_2025.pdf","Remarque":"Notre calendrier contient déjà plusieurs transports de Pruszków mais pas 5 534 fiches nominatives."}},{"id":"NEW-007","title":"Reconstruction inter-camps","values":{"ID":"NEW-007","Type":"Reconstruction inter-camps","Date / période":"1944–1945","Origine":"Auschwitz","Destination / ensemble":"Dachau / Flossenbürg","Effectif":">30 000","Identités documentées":"Projet de reconstruction historique","État dans notre base":"Absent comme corpus","Priorité":3,"Source":"https://auschwitz.org/en/museum/news/destroyed-identities-the-digital-reconstruction-of-auschwitz-birkenau-victims-data%2C1398.html","Remarque":"À traiter plus tard par lots et rapprochement inter-camps."}},{"id":"NEW-008","title":"Reconstruction nominative","values":{"ID":"NEW-008","Type":"Reconstruction nominative","Date / période":"1944","Origine":"Hongrie","Destination / ensemble":"Auschwitz","Effectif":">400 000","Identités documentées":"Projet de reconstruction historique","État dans notre base":"Partiel","Priorité":3,"Source":"https://auschwitz.org/en/museum/news/destroyed-identities-the-digital-reconstruction-of-auschwitz-birkenau-victims-data%2C1398.html","Remarque":"Ne pas convertir un total de déportation en identités sans source nominative individuelle."}}]
