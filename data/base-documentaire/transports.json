art":"1944-09-03","Date d’arrivée":"1944-09-05","Origine":"Westerbork, Pays-Bas","Transit":"dernier transport Westerbork-Auschwitz","Groupe déporté":"Juifs des Pays-Bas, dont la famille Frank","Nombre au départ":1019,"Notes":"Effectif détaillé à recouper avec les listes de Westerbork.","Source":"S03","Niveau de confiance":"Événement établi, effectif à confirmer"}},{"id":"T015","title":"Complexe d'Auschwitz","values":{"Identifiant":"T015","Date de départ":"1945-01-17","Date d’arrivée":"1945-01-23","Origine":"Complexe d'Auschwitz","Transit":"marches vers Wodzisław et Gliwice, puis trains","Groupe déporté":"Prisonniers évacués, majoritairement juifs","Nombre au départ":58000,"Notes":"Environ 56 000 forcés à marcher et 2 000 évacués par train; de nombreux morts en route.","Source":"S10","Niveau de confiance":"Estimation de référence"}},{"id":"T016","title":"Auschwitz","values":{"Identifiant":"T016","Date de départ":"1944-08-25","Date d’arrivée":"1944-08-25","Origine":"Auschwitz","Transit":"transfert inter-camps","Groupe déporté":"750 hommes transférés vers Neuengamme","Nombre au départ":750,"Notes":"Transfert sortant : ne pas additionner aux arrivées à Auschwitz. 550 identités reconstruites dans le projet documentaire cité.","Source":"S23","Niveau de confiance":"Effectif établi; identité de tous les transférés non encore reconstruite"}},{"id":"T017","title":"Auschwitz","values":{"Identifiant":"T017","Date de départ":"1944-10-27","Date d’arrivée":"1944-10-27","Origine":"Auschwitz","Transit":"transfert inter-camps","Groupe déporté":"Prisonniers transférés vers Sachsenhausen","Nombre au départ":2249,"Notes":"Transfert sortant : ne pas additionner aux arrivées à Auschwitz. 349 noms conservés sur les listes; 257 dossiers individuels supplémentaires obtenus des Arolsen Archives.","Source":"S24","Niveau de confiance":"Effectif établi; documentation nominative partielle"}}]
